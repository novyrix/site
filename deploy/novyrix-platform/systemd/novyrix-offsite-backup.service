[Unit]
Description=Validate and replicate Novyrix PostgreSQL backups to R2
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target novyrix-postgres-backup.service

[Service]
Type=oneshot
EnvironmentFile=/etc/novyrix/secrets/restic-r2.env
ExecStart=/srv/novyrix/deploy/novyrix-platform/scripts/offsite-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/novyrix/backups/postgres /srv/novyrix/deploy/novyrix-platform
ReadWritePaths=/var/cache/novyrix/restic
