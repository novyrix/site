NOVYRIX_API_URL=https://api.novyrix.com
NOVYRIX_API_TOKEN=replace-with-the-api-shared-secret
NOVYRIX_PAYMENT_PREVIEW_ENABLED=false
NOVYRIX_PAYMENT_PREVIEW_CONNECTED=false
NOVYRIX_ADMIN_PREVIEW_ENABLED=false
NOVYRIX_PORTAL_PREVIEW_ENABLED=false
AUTH_SECRET=replace-with-a-long-random-auth-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
NOVYRIX_ADMIN_EMAIL=spira@novyrix.com
NOVYRIX_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
# Local emergency use only. Vercel production always disables credentials auth.
AUTH_CREDENTIALS_FALLBACK=false

# Platform API only. Keep provider values in ignored local files or encrypted host env.
PAYMENTS_LIVE=false
PAYMENT_SITE_URL=https://pay.novyrix.com
PAYMENT_LINK_SECRET=replace-with-a-distinct-random-secret
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
BTCPAY_BASE_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
